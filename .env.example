# ── Supabase (required) ─────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Gemini AI (required for AI features) ────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenWeatherMap (required for weather dashboard) ──────────────────────────
# Free tier: 1,000 calls/day at https://openweathermap.org/api
# Required plan: One Call API 3.0 (free subscription needed)
VITE_OPENWEATHER_KEY=your_openweathermap_key_here

# ── Optional: Sarvam AI for Indian language TTS/STT ─────────────────────────
# Better Indian language voice quality — https://sarvam.ai
# VITE_SARVAM_API_KEY=your_sarvam_api_key_here

# ── App URL (for OAuth redirects) ────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
